<MudCard
    Class="mud-width-full mud-height-full"
    Outlined
>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">
                Card Title
            </MudText>
            <MudText
                Typo="Typo.body2"
                Class="mud-text-disabled"
            >
                Card Description
            </MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent Class="py-0">
        @if (ChildContent != null)
        {
            @ChildContent
        }
        else
        {
            <MudPaper
                Class="mud-width-full mud-height-full d-flex justify-center align-center"
                Style="border-style: dashed"
                Outlined
            >
                <MudText Class="mud-text-disabled">
                    Card Content
                </MudText>
            </MudPaper>
        }
    </MudCardContent>
    <MudCardActions Class="pa-4">
        <MudButton
            StartIcon="@Icons.Material.Rounded.AdsClick"
            IconSize="Size.Small"
            Variant="Variant.Outlined"
            DropShadow="false"
        >
            Manage
        </MudButton>
    </MudCardActions>
</MudCard>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
