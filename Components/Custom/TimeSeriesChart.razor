@using System.Globalization

<MudChart T="double" ChartType="ChartType.Timeseries" ChartOptions="Options" ChartSeries="Series" Width="100%"
					Height="350px" MatchBoundsToSize CanHideSeries Class="@(CurrentBreakpoint != Breakpoint.Xs ? "px-4" : "px-0")">
	<TooltipTemplate Context="tooltip">
		@{
			var tooltipHeight = TooltipHeight;
			var tooltipY = -tooltipHeight - 10;
			var headerY = tooltipY + Padding + 12;
			var rowY = headerY + HeaderHeight;
		}

		<g>
			<rect x="-70" y="@tooltipY" width="154" height="@tooltipHeight" rx="8" fill="var(--mud-palette-background)"
						style="filter: drop-shadow(0 4px 8px rgba(0,0,0,.25));" />

			<text x="-58" y="@headerY" fill="var(--mud-palette-text-primary)" font-size="12" font-weight="600">
				@tooltip.Segment.LabelXValue
			</text>

			<rect x="-58" y="@(rowY - 7)" width="9" height="9" rx="2" fill="@tooltip.Color" />

			<text x="-43" y="@(rowY + 2)" fill="var(--mud-palette-text-disabled)" font-size="11">
				@ToTitleCase(Series[tooltip.Segment.Index].Name)
			</text>

			<text x="74" y="@(rowY + 2)" fill="var(--mud-palette-text-primary)" font-size="11" font-family="Geist Mono"
						font-weight="600" text-anchor="end">
				@(FormatYValue(double.Parse(tooltip.Segment.LabelYValue)))
			</text>
		</g>
	</TooltipTemplate>
</MudChart>

@code
{
	[CascadingParameter]
	public Breakpoint CurrentBreakpoint { get; set; }

	[Parameter]
	public List<ChartSeries<double>> Series { get; set; } = [];

	[Parameter]
	public required TimeRange TimeRange { get; set; }

	[Parameter]
	public bool ShowDataMarkers { get; set; } = false;

	private TimeSeriesChartOptions Options = new();

	private double MaxValue = 0;

	private const int Padding = 6;
	private const int HeaderHeight = 18;
	private const int RowHeight = 18;
	private int TooltipHeight => Padding * 2 + HeaderHeight + RowHeight;

	protected override void OnParametersSet()
	{
		var range = TimeRanges.Values[TimeRange];
		MaxValue = Series.SelectMany(series => series.Data).Max();

		Options = new()
		{
			ShowDataMarkers = ShowDataMarkers,
			InterpolationOption = InterpolationOption.NaturalSpline,
			LineDisplayType = LineDisplayType.Line,
			LineStrokeWidth = 2,
			MaxNumYAxisTicks = 10,
			// YAxisTicks = MaxValue switch
			// {
			// < 100 => 1,
			// < 1_000 => 10,
			// < 10_000 => 100,
			// < 100_000 => 1_000,
			// _ => 10_000
			// },
			YAxisTicks = 1_000,
			YAxisLines = true,
			YAxisToStringFunc = value => FormatYValue(value),
			TooltipTimeLabelFormat = "dd.MM.yyy\u00A0\u00A0•\u00A0\u00A0HH:mm",
			TimeLabelFormat = range.Format,
			TimeLabelSpacing = range.GetSpacing(CurrentBreakpoint),
			TimeLabelSpacingRounding = true,
			ChartPalette = [Green._400, Teal._400, Sky._400, Indigo._400]
		};
	}

	private string FormatYValue(double value)
	{
		return value.ToString("N0", CultureInfo.GetCultureInfo("de-CH"));
	}

	public static ChartSeries<double> CreateSeries(string name, List<List<double>> data) => new()
	{
		Name = name,
		Data = new ChartData<double>(ToDataPoints(data))
	};

	private static (DateTime, double)[] ToDataPoints(List<List<double>> series) =>
	[
			..series
				.Where(point => point.Count >= 2)
				.Select(point => (
						DateTimeOffset.FromUnixTimeMilliseconds((long)point[0]).LocalDateTime,
						point[1]
				))
	];
}
