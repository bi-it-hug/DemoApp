@inject AppStateService AppStateService

<MudDialog
    TitleClass="px-4 pt-4 pb-0 gap-1 d-flex justify-space-between align-start"
    ActionsClass="px-4 pb-4 pt-0"
    ContentClass="px-4 py-0"
    Class="border mud-border-tertiary mud-dialog-width-xs gap-4"
>
    <TitleContent>
        <MudStack
            Spacing="1"
        >
            <MudText Typo="Typo.body1">
                Settings
            </MudText>
            <MudText
                Typo="Typo.subtitle2"
                Class="mud-text-disabled"
            >
                Make changes to your liking here.
            </MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <SettingsRow
                Label="Theme"
            >
                <MudSelect
                    T="ThemeMode"
                    Variant="Variant.Outlined"
                    Margin="Margin.Dense"
                    FitContent
                    Dense
                    Class="my-0"
                    InputClass="pa-1"
                    PopoverClass="mt-1 border mud-border-tertiary rounded"
                    ListClass="d-flex flex-column pa-1 gap-1"
                    @bind-Value="@CurrentTheme"
                >
                    @foreach (var variant in Enum.GetValues<ThemeMode>())
                    {
                        <MudSelectItem
                            T="ThemeMode"
                            Value="@variant"
                            Class="rounded pa-2"
                        >
                            @variant
                        </MudSelectItem>
                    }
                </MudSelect>
            </SettingsRow>

            <SettingsRow
                Label="Some Toggle"
            >
                <MudSwitch @bind-Value="CurrentSwitchState" />
            </SettingsRow>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="Submit">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    private ThemeMode CurrentTheme { get; set; }
    private bool CurrentSwitchState { get; set; }

    protected override void OnInitialized()
    {
        CurrentTheme = AppStateService.Settings.ThemeMode;
        CurrentSwitchState = AppStateService.Settings.TestSwitch;
    }

    private async Task Submit()
    {
        await AppStateService.SetThemeModeAsync(CurrentTheme);
        await AppStateService.SetTestSwitchAsync(CurrentSwitchState);
        MudDialog?.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog?.Cancel();

    private string GetIcon(ThemeMode mode) => mode switch
    {
        ThemeMode.Light => Icons.Material.Rounded.LightMode,
        ThemeMode.Dark => Icons.Material.Rounded.DarkMode,
        _ => Icons.Material.Rounded.AutoMode
    };
}
