@implements IDisposable

@inject AppStateService AppState

@* Dropdown Menu *@
<MudMenu
    Icon="@CurrentIcon"
    Size="Size.Small"
    Variant="Variant.Outlined"
    ActivationEvent="@MouseEvent.MouseOver"
    TransformOrigin="Origin.TopRight"
    AnchorOrigin="Origin.BottomRight"
    PopoverClass="border mud-border-tertiary mt-1 pa-1"
    Dense
>
    <MudMenuItem
        Icon="@Icons.Material.Rounded.AutoMode"
        Label="System"
        OnClick="@(() => AppState.SetThemeModeAsync(ThemeMode.System))"
        Class="rounded px-2"
    />
    <MudMenuItem
        Icon="@Icons.Material.Rounded.LightMode"
        Label="Light"
        OnClick="@(() => AppState.SetThemeModeAsync(ThemeMode.Light))"
        Class="rounded px-2"
    />
    <MudMenuItem
        Icon="@Icons.Material.Rounded.DarkMode"
        Label="Dark"
        OnClick="@(() => AppState.SetThemeModeAsync(ThemeMode.Dark))"
        Class="rounded px-2"
    />
</MudMenu>

@code {
    private string CurrentIcon => AppState.Settings.ThemeMode switch
    {
        ThemeMode.Light => Icons.Material.Rounded.LightMode,
        ThemeMode.Dark => Icons.Material.Rounded.DarkMode,
        _ => Icons.Material.Rounded.AutoMode
    };

    protected override void OnInitialized()
    {
        AppState.Changed += OnAppStateChanged;
    }

    private void OnAppStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AppState.Changed -= OnAppStateChanged;
    }
}

@* Simple Button *@
@*
<MudTooltip
    Text="@($"Switch to {(AppState.Settings.IsDarkMode ? "Light" : "Dark")} Mode")"
    Placement="Placement.Left"
