@* PopoverClass="border mud-border-tertiary mt-1 pa-1" *@

@* Dropdown Menu *@
<MudMenu
    Icon="CurrentIcon"
    Size="Size.Small"
    Variant="Variant.Outlined"
    TransformOrigin="Origin.TopRight"
    AnchorOrigin="Origin.BottomRight"
    PopoverClass="border mud-border-tertiary mt-1 pa-1"
    ListClass="d-flex flex-column gap-1"
    Dense
>
    <MudMenuItem
        Icon="@Icons.Material.Rounded.AutoMode"
        Label="System"
        OnClick="@(() => AppStateService.SetThemeModeAsync(ThemeMode.System))"
        Class="pa-2 rounded"
    />
    <MudMenuItem
        Icon="@Icons.Material.Rounded.LightMode"
        Label="Light"
        OnClick="@(() => AppStateService.SetThemeModeAsync(ThemeMode.Light))"
        Class="pa-2 rounded"
    />
    <MudMenuItem
        Icon="@Icons.Material.Rounded.DarkMode"
        Label="Dark"
        OnClick="@(() => AppStateService.SetThemeModeAsync(ThemeMode.Dark))"
        Class="pa-2 rounded"
    />
</MudMenu>

@code {
    private string CurrentIcon => AppStateService.Settings.ThemeMode switch
    {
        ThemeMode.Light => Icons.Material.Rounded.LightMode,
        ThemeMode.Dark => Icons.Material.Rounded.DarkMode,
        _ => Icons.Material.Rounded.AutoMode
    };
}

@* Simple Button *@
@*
<MudTooltip
    Text="@($"Switch to {(AppState.Settings.IsDarkMode ? "Light" : "Dark")} Mode")"
    Placement="Placement.Left"
    Arrow
>
    <MudIconButton
        Variant="Variant.Text"
        Size="Size.Small"
        Color="Color.Inherit"
        OnClick="@AppState.ToggleDarkModeAsync"
        DropShadow="false"
        Icon="@(
            AppState.Settings.IsDarkMode
            ? Icons.Material.Rounded.LightMode
            : Icons.Material.Rounded.DarkMode
        )"
    />
</MudTooltip>
*@
