@using DemoApp.Services

@inject NavigationManager NavigationManager
@inject AppStateService AppStateService

<style>
    .active .mud-nav-link-text,
    .active .mud-nav-link-icon {
        color: var(--mud-palette-primary) !important;
    }
</style>

@if (AppStateService.Settings.IsDrawerOpen)
{
    <MudNavLink
        Href="@Href"
        Match="@Match"
        Icon="@Icon"
        Class="@Class"
        ActiveClass="active"
        OnClick="@OnClick"
        Style="white-space: nowrap"
    >
        @ChildContent
    </MudNavLink>
}
else
{
    <MudTooltip
        Placement="Placement.Right"
        Arrow
    >
        <ChildContent>
            <MudNavLink
                Href="@Href"
                Match="@Match"
                Icon="@Icon"
                Class="@Class"
                ActiveClass="active"
                OnClick="@OnClick"
            >
                @ChildContent
            </MudNavLink>
        </ChildContent>
        <TooltipContent>
            @ChildContent
        </TooltipContent>
    </MudTooltip>
}

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public required NavLinkMatch Match { get; set; }

    [Parameter]
    public required string Icon { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public string? Class { get; set; }
}
