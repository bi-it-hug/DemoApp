<MudDialog
    TitleClass="px-4 pt-4 pb-0 gap-2 d-flex justify-start align-center"
    ActionsClass="px-4 pb-4 pt-0"
    Class="no-shadow border mud-border-tertiary"
>
    <TitleContent>
        <MudIcon
            Icon="@Icons.Material.Rounded.Info"
            Size="Size.Small"
        />
        <MudText Typo="Typo.body1">
            This is a random Dialog
        </MudText>
    </TitleContent>
    @* <DialogContent>
        Dialog Content
    </DialogContent> *@
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="Submit">OK</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }
    private void Submit() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancel() => MudDialog.Cancel();
}
