@page "/not-found"

<PageTitle>Not Found</PageTitle>

<MudStack
    Spacing="0"
    Class="mud-width-full mud-height-full"
>
    <MudStack
        Justify="Justify.Center"
        AlignItems="AlignItems.Center"
        Class="mud-height-full"
    >
        <MudText
            Typo="Typo.h3"
            Align="Align.Center"
            Class="mud-width-full"
        >
            404 - Page Not Found
        </MudText>

        <MudText
            Align="Align.Center"
            Class="mb-3 mud-width-full mud-text-disabled"
        >
            Sorry, the content you are looking for does not exist.
        </MudText>

        <MudButton
            StartIcon="@Icons.Material.Rounded.KeyboardDoubleArrowLeft"
            IconSize="Size.Large"
            Href="/"
            Variant="Variant.Filled"
            DropShadow="false"
        >
            Go Back
        </MudButton>
    </MudStack>
</MudStack>
