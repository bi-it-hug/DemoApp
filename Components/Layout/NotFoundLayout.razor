@inherits LayoutComponentBase
@implements IDisposable

@inject AppStateService AppState

<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudThemeProvider
    @ref="_themeProvider"
    Theme="@_theme"
    IsDarkMode="@_isDarkMode"
    IsDarkModeChanged="OnIsDarkModeChanged"
    ObserveSystemDarkModeChange="@ObserveSystemDarkMode"
/>

<MudLayout>
    <MudAppBar
        Class="align-end"
        Style="background-color: var(--mud-palette-background)"
    >
        <ThemeSwitch />
    </MudAppBar>
    <MudMainContent Class="d-flex justify-center align-center flex-column mud-width-full mud-height-full">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme _theme = Theme.Create();
    private MudThemeProvider _themeProvider = default!;
    private bool _isDarkMode;

    private bool ObserveSystemDarkMode =>
        AppState.Settings.ThemeMode == ThemeMode.System;

    protected override void OnInitialized()
    {
        AppState.Changed += OnStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await AppState.InitializeAsync();
        await SyncDarkModeAsync();
    }

    private void OnIsDarkModeChanged(bool value)
    {
        if (!ObserveSystemDarkMode)
            return;

        _isDarkMode = value;
    }

    private async Task SyncDarkModeAsync()
    {
        _isDarkMode = AppState.Settings.ThemeMode switch
        {
            ThemeMode.Dark => true,
            ThemeMode.Light => false,
            _ => await _themeProvider.GetSystemDarkModeAsync()
        };

        await InvokeAsync(StateHasChanged);
    }

    private void OnStateChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await SyncDarkModeAsync();
        });
    }

    public void Dispose()
    {
        AppState.Changed -= OnStateChanged;
    }
}
