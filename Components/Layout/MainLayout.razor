@inherits LayoutComponentBase
@implements IDisposable

@inject NotificationService NotificationService
@inject NavigationManager NavigationManager
@inject AppStateService AppStateService

@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudPopoverProvider />
<MudSnackbarProvider />
<MudDialogProvider
    MaxWidth="MaxWidth.Small"
    FullWidth="true"
/>

<MudThemeProvider
    @ref="ThemeProvider"
    Theme="@Theme"
    IsDarkMode="@IsDarkMode"
    IsDarkModeChanged="OnIsDarkModeChanged"
    ObserveSystemDarkModeChange="@ObserveSystemDarkMode"
    DefaultScrollbar
/>

<MudLayout>
    @if (!AppStateService.IsInitialized)
    {
        <MudStack
            Justify="Justify.Center"
            AlignItems="AlignItems.Center"
            Class="mud-width-full mud-height-full"
        >
            <MudProgressCircular Indeterminate="true" />
        </MudStack>
    }
    else
    {
        <MudAppBar ToolBarClass="px-4">


            @if (CurrentPage != "Not-Found")
            {
                <SidebarToggle />

                <MudBreadcrumbs
                Items="@Items"
                Class="ml-2"
                >
                    <SeparatorTemplate>
                        <MudIcon
                        Icon="@Icons.Material.Rounded.ChevronRight"
                        Size="Size.Small"
                        Style="opacity: 50%"
                        />
                    </SeparatorTemplate>
                </MudBreadcrumbs>
            }

            <MudSpacer />

            <MudStack
                Justify="Justify.Center"
                AlignItems="AlignItems.Center"
                Row
            >
                @if (CurrentPage != "Not-Found")
                {
                    <MudButton
                        Variant="Variant.Outlined"
                        OnClick="AddTestNotification"
                    >
                        Notification Test
                    </MudButton>
                    <NotificationMenu />
                }
                <ThemeSwitch />
            </MudStack>
        </MudAppBar>

        @if (CurrentPage != "Not-Found")
        {
            <MudDrawer
                Open="@AppStateService.Settings.IsDrawerOpen"
                OpenChanged="@AppStateService.SetDrawerOpenAsync"
                Variant="DrawerVariant.Mini"
                ClipMode="DrawerClipMode.Never"
                Breakpoint="Breakpoint.Sm"
                Class="border-r mud-border-tertiary pa-3"
            >
                <MudNavMenu
                    Margin="Margin.Dense"
                    Class="d-flex flex-column gap-1"
                    Rounded
                    Dense
                >
                    <CascadingValue Value="CurrentPage">
                        <TooltipNavLink
                            Href=""
                            Match="NavLinkMatch.All"
                            Icon="@Icons.Material.Rounded.Dashboard"
                        >
                            Dashboard
                        </TooltipNavLink>

                        <TooltipNavLink
                            Href="playground"
                            Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Rounded.Architecture"
                        >
                            Playground
                        </TooltipNavLink>

                        <TooltipNavLink
                            Href="not-found"
                            Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Rounded.Error"
                        >
                            Not Found
                        </TooltipNavLink>
                    </CascadingValue>
                </MudNavMenu>

                <MudSpacer />

                <MudNavMenu
                    Margin="Margin.Dense"
                    Class="d-flex flex-column gap-1"
                    Rounded
                    Dense
                >
                    <TooltipNavLink
                        OnClick="@(() => OpenDialogAsync(SettingsDialogOptions))"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Rounded.Settings"
                    >
                        Settings
                    </TooltipNavLink>
                </MudNavMenu>
            </MudDrawer>
        }

        <MudMainContent
            Class="d-flex justify-center align-center mud-height-full"
            Style="background-color: var(--mud-palette-appbar-background)"
        >
            <MudContainer
                MaxWidth="MaxWidth.ExtraExtraLarge"
                Gutters="false"
                Class="mud-height-full"
                Style="background-color: var(--mud-palette-background)"
            >
                @Body
            </MudContainer>
        </MudMainContent>
    }
</MudLayout>

    @code {
    private readonly MudTheme Theme = DemoApp.Theme.Theme.Create();
    private MudThemeProvider ThemeProvider = default!;
    private List<BreadcrumbItem> Items = [];
    private string CurrentPage = "";
    private bool IsDarkMode;

    private readonly DialogOptions SettingsDialogOptions = new() { CloseButton = false };

    private Task OpenDialogAsync(DialogOptions options)
    {
        return DialogService.ShowAsync<SettingsDialog>("", options);
    }

    public async Task AddTestNotification()
    {
        Notification TestNotification = new(
            "playground?dialog=test",
            "Lorem ipsum dolor sit amet",
            "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
            Severity.Success
        );

        Snackbar.Add(TestNotification.Title, TestNotification.Severity);
        await NotificationService.AddAsync(TestNotification);
    }

    private bool ObserveSystemDarkMode => AppStateService.Settings.ThemeMode == ThemeMode.System;

    protected override void OnInitialized()
    {
        AppStateService.Changed += OnStateChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
        UpdateBreadcrumbs(NavigationManager.Uri);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateBreadcrumbs(e.Location);
        _ = InvokeAsync(StateHasChanged);
        Console.WriteLine(CurrentPage);
    }

    private void UpdateBreadcrumbs(string uri)
    {
        var relativePath = NavigationManager.ToBaseRelativePath(uri);
        CurrentPage = string.IsNullOrWhiteSpace(relativePath) ? "Dashboard" : StringUtilities.ToTitleCase(relativePath);

        Items =
        [
            new BreadcrumbItem("Demo App", href: relativePath),
            new BreadcrumbItem(CurrentPage, href: relativePath),
            // new BreadcrumbItem("Link 1", href: "#")
        ];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await AppStateService.InitializeAsync();
        await SyncDarkModeAsync();
    }

    private void OnIsDarkModeChanged(bool value)
    {
        if (!ObserveSystemDarkMode) return;
        IsDarkMode = value;
    }

    private async Task SyncDarkModeAsync()
    {
        IsDarkMode = AppStateService.Settings.ThemeMode switch
        {
            ThemeMode.Dark => true,
            ThemeMode.Light => false,
            _ => await ThemeProvider.GetSystemDarkModeAsync()
        };

        await InvokeAsync(StateHasChanged);
    }

    private void OnStateChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await SyncDarkModeAsync();
        });
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        AppStateService.Changed -= OnStateChanged;
    }
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
