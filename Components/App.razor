<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <base href="/" />
        <ResourcePreloader />
        <link href="https://fonts.googleapis.com/css2?family=Geist:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
        <link rel="stylesheet" href="@Assets["DemoApp.styles.css"]" />
        <ImportMap />
        <link rel="icon" type="image/ico" href="favicon.ico" />
        <HeadOutlet @rendermode="InteractiveServer" />
        <style>
            ::selection {
                background-color: var(--mud-palette-text-primary);
                color: var(--mud-palette-background);
            }

            .mud-list-item-text {
                margin: 0 !important;
            }

            .mud-menu-list {
                padding: 0px !important;
            }

            .mud-menu-item-text {
                margin: 0 !important;
            }

            .mud-menu-item-icon {
                width: 1.125rem !important;
                height: 1.125rem !important;
                margin-right: 0.5rem !important;
            }

            .mud-nav-link {
                margin: 0 !important;
                padding: 6px !important;
            }

            .mud-nav-link-text {
                margin-left: 6px !important;
            }

            .mud-nav-link-icon {
                width: 1.25rem !important;
                height: 1.25rem !important;
            }

            .clear .mud-icon-root {
                padding: 2px;
            }

            .mud-icon-button-size-small {
                padding: 6px;
            }

            .mud-button-outlined-size-small.mud-icon-button {
                padding: 5px !important;
            }

            .mud-button-outlined-size-medium {
                padding-block: 6px !important;
                padding-inline: 12px !important;
            }
        </style>
    </head>

    <body style="height: 100vh">
        <Routes @rendermode="InteractiveServer" />
        <ReconnectModal />
        <script src="@Assets["_framework/blazor.web.js"]"></script>
        <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    </body>
</html>
